    <mxGraphModel dx="4478" dy="2322" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  direction LR\n\n  namespace Model {\n    class MenuItem {\n      &lt;&lt;abstract&gt;&gt;\n      -int id\n      -String name\n      -double price\n      -Category category\n      +getPrice() double\n    }\n\n    class Drink {\n      -DrinkSize size\n    }\n\n    class Food\n\n    class Combo {\n      -List~MenuItem~ items\n      +addItem(MenuItem item) void\n    }\n\n    class Order {\n      -int id\n      -OrderStatus status\n      -List~OrderItem~ items\n      +addItem(OrderItem item) void\n      +getTotal() double\n    }\n\n    class OrderItem {\n      -MenuItem menuItem\n      -int quantity\n      -double unitPrice\n      +getSubtotal() double\n    }\n\n    class CafeTable {\n      -int number\n      -boolean occupied\n    }\n\n    class DrinkSize {\n      &lt;&lt;enumeration&gt;&gt;\n      SMALL\n      MEDIUM\n      LARGE\n    }\n\n    class OrderStatus {\n      &lt;&lt;enumeration&gt;&gt;\n      OPEN\n      PAID\n      CANCELLED\n    }\n\n    class Category {\n      &lt;&lt;enumeration&gt;&gt;\n      DRINK\n      FOOD\n      COMBO\n    }\n\n    MenuItem &lt;|-- Drink\n    MenuItem &lt;|-- Food\n    MenuItem &lt;|-- Combo\n    Combo \&quot;1\&quot; *-- \&quot;0..*\&quot; MenuItem : contains\n    Order \&quot;1\&quot; *-- \&quot;0..*\&quot; OrderItem : contains\n    OrderItem \&quot;1\&quot; --&gt; \&quot;1\&quot; MenuItem : references\n    Drink --&gt; DrinkSize\n    MenuItem --&gt; Category\n    Order --&gt; OrderStatus\n  }\n\n  namespace Service {\n    class DiscountStrategy {\n      &lt;&lt;interface&gt;&gt;\n      +calculateDiscount(total: double) double\n    }\n\n    class NoDiscount {\n      +calculateDiscount(total: double) double\n    }\n\n    class PercentDiscount {\n      -double percentage\n      +calculateDiscount(total: double) double\n    }\n\n    class HappyHourDiscount {\n      +calculateDiscount(total: double) double\n    }\n\n    class MemberDiscount {\n      +calculateDiscount(total: double) double\n    }\n\n    class PaymentService {\n      +processPayment(order: Order, amount: double) void\n    }\n\n    class InvalidPaymentException {\n      &lt;&lt;exception&gt;&gt;\n    }\n\n    class InvalidOrderException {\n      &lt;&lt;exception&gt;&gt;\n    }\n\n    DiscountStrategy &lt;|.. NoDiscount\n    DiscountStrategy &lt;|.. PercentDiscount\n    DiscountStrategy &lt;|.. HappyHourDiscount\n    DiscountStrategy &lt;|.. MemberDiscount\n    PaymentService ..&gt; Order : processes\n    PaymentService ..&gt; InvalidPaymentException : throws\n    PaymentService ..&gt; InvalidOrderException : throws\n  }\n\n  namespace Repository {\n    class MenuRepository {\n      &lt;&lt;interface&gt;&gt;\n      +findAll() List~MenuItem~\n      +findById(id: int) MenuItem\n    }\n\n    class InMemoryMenuRepository {\n      -List~MenuItem~ items\n    }\n\n    class SalesRepository {\n      &lt;&lt;interface&gt;&gt;\n      +save(order: Order) void\n      +findAll() List~Order~\n    }\n\n    class InMemorySalesRepository {\n      -List~Order~ orders\n      +save(order: Order) void\n      +findAll() List~Order~\n    }\n\n    MenuRepository &lt;|.. InMemoryMenuRepository\n    SalesRepository &lt;|.. InMemorySalesRepository\n    InMemoryMenuRepository \&quot;1\&quot; *-- \&quot;0..*\&quot; MenuItem : stores\n    InMemorySalesRepository \&quot;1\&quot; *-- \&quot;0..*\&quot; Order : stores\n  }\n\n  namespace UI {\n    class BaseWindow {\n      &lt;&lt;abstract&gt;&gt;\n    }\n\n    class MainWindow {\n      -MenuPanel menuPanel\n      -CartPanel cartPanel\n      -TablePanel tablePanel\n      -ReportWindow reportWindow\n    }\n\n    class MenuPanel\n    class CartPanel\n    class TablePanel\n    class ReportWindow\n    class CheckoutDialog\n    class CartTableModel\n\n    BaseWindow &lt;|-- MainWindow\n    MainWindow \&quot;1\&quot; *-- \&quot;1\&quot; MenuPanel : coordinates\n    MainWindow \&quot;1\&quot; *-- \&quot;1\&quot; CartPanel : coordinates\n    MainWindow \&quot;1\&quot; *-- \&quot;1\&quot; TablePanel : coordinates\n    MainWindow \&quot;1\&quot; *-- \&quot;1\&quot; ReportWindow : coordinates\n    MenuPanel ..&gt; MenuRepository : uses\n    CartPanel ..&gt; Order : works with\n    CartPanel ..&gt; OrderItem : works with\n    CartPanel ..&gt; CheckoutDialog : opens\n    CheckoutDialog ..&gt; PaymentService : uses\n    ReportWindow ..&gt; SalesRepository : uses\n    TablePanel ..&gt; CafeTable : displays\n    CartPanel ..&gt; CartTableModel : uses\n  }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Lf42YKcQyuY2bGQ7vTaX-347">
